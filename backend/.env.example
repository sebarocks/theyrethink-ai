# Copia este archivo a `.env` y complétalo. `.env` nunca se versiona (ver AGENTS.md §5).

# development | test | production
ENVIRONMENT=development

# Obligatoria, mínimo 32 caracteres, SIN valor por defecto: la aplicación no arranca sin ella.
# Genera una con: openssl rand -hex 32
SECRET_KEY=

# Base de datos (driver async de SQLAlchemy).
DATABASE_URL=postgresql+asyncpg://theyrethink:theyrethink@localhost:5432/theyrethink

# Cliente LLM (D15): cualquier endpoint OpenAI-compatible.
# El proveedor y el modelo se eligen aquí, no en el código.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Primer administrador (D13). Sin contraseña por defecto: si ADMIN_PASSWORD queda vacía,
# el seed NO crea la cuenta y avisa (AGENTS.md §5).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Override OPCIONAL del contexto del modelo (techo de memoria, D7). Normalmente se descubre
# desde `GET /models`; solo hace falta si el proveedor no lo publica (p. ej. la API de OpenAI).
LLM_CONTEXT_TOKENS=
