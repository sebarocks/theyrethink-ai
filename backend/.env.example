# Copia este archivo a `.env` y complétalo. `.env` nunca se versiona (ver AGENTS.md §5).

# development | test | production
ENVIRONMENT=development

# Obligatoria, mínimo 32 caracteres, SIN valor por defecto: la aplicación no arranca sin ella.
# Genera una con: openssl rand -hex 32
SECRET_KEY=

# Base de datos (driver async de SQLAlchemy).
DATABASE_URL=postgresql+asyncpg://theyrethink:theyrethink@localhost:5432/theyrethink

# Cliente LLM (D15): cualquier endpoint OpenAI-compatible.
# El proveedor y el modelo se eligen aquí, no en el código.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Primer administrador (D13). Sin contraseña por defecto: si ADMIN_PASSWORD queda vacía,
# el seed NO crea la cuenta y avisa (AGENTS.md §5).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Override OPCIONAL del contexto del modelo (techo de memoria, D7). Normalmente se descubre
# desde `GET /models`; solo hace falta si el proveedor no lo publica (p. ej. la API de OpenAI).
LLM_CONTEXT_TOKENS=

# ---------------------------------------------------------------------------------------
# Sesión y contraseñas (D24, ADR 0027)
# ---------------------------------------------------------------------------------------
# `Secure` no se apaga salvo en desarrollo servido por HTTP sin TLS.
SESSION_COOKIE_SECURE=true
# lax | strict | none
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_DAYS=30
# Mínimo 8. En producción conviene subirlo (p. ej. 12).
PASSWORD_MIN_LENGTH=8
# Orígenes extra para CSRF por `Origin`, separados por comas. Vacío = solo el mismo origen.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------------------
# Límite de peticiones (D23, ADR 0026). `0` desactiva el alcance.
# ---------------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_ATTEMPTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
RATE_LIMIT_CHAT_ATTEMPTS=30
RATE_LIMIT_CHAT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------------------
# Observabilidad (D25, ADR 0028)
# ---------------------------------------------------------------------------------------
LOG_LEVEL=INFO
# text | json (json en producción)
LOG_FORMAT=text
# `/metrics` está desactivado por defecto; con METRICS_TOKEN exige Authorization: Bearer.
METRICS_ENABLED=false
METRICS_TOKEN=

# ---------------------------------------------------------------------------------------
# Runtime del contenedor (D22, ADR 0025). Los lee `backend/scripts/serve.sh`.
# ---------------------------------------------------------------------------------------
# Nº de workers de uvicorn; vacío = número de CPUs.
WEB_CONCURRENCY=
PORT=8000
GRACEFUL_SHUTDOWN_SECONDS=30
# Solo si hay un proxy de confianza delante (activa --proxy-headers con esa lista de IPs).
FORWARDED_ALLOW_IPS=
